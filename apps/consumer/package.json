{
  "name": "@worksight/consumer",
  "version": "0.0.0",
  "private": true,
  "description": "Daylens: see your day clearly",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "node ../../scripts/rebuild-native.cjs",
    "dev": "electron-vite dev",
    "pretest": "pnpm rebuild better-sqlite3",
    "test": "vitest run",
    "test:parity": "vitest run src/main/brain/laya.parity.test.ts",
    "test:eval": "vitest run src/main/brain/laya.eval.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "logo": "electron scripts/logo/render.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3",
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.8.1",
    "node-llama-cpp": "^3.21.1",
    "onnxruntime-node": "1.21.0",
    "uiohook-napi": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@worksight/core": "workspace:*",
    "electron": "^33.3.1",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
