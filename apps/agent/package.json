    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.7.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "typescript": "^5.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@vitejs/plugin-react": "^4.3.4",
