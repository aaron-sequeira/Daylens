# From `supabase status` (local). The runtime uses ONLY the anon key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=__anon_key_from_supabase_status__
# Used ONLY by scripts/seed.mjs — never imported by the app runtime:
SUPABASE_SERVICE_ROLE_KEY=__service_role_key_from_supabase_status__
